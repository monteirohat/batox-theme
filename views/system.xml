<?xml version="1.0" encoding="UTF-8"?>
<!--
  The theme's home, after a console's home screen: one row of square tiles with white system
  icons, 5 px apart; the selected tile, in the second place, grows 1.7 times into a card with a
  strip with its number of games under it, framed in white, and the system's name shows at its right.
  A carousel (not a grid): in a carousel each system has its own copy of the view's elements, so
  the background and the texts follow the selection.
-->
<theme>
  <formatVersion>7</formatVersion>
  <view name="system" extraTransition="fade" extraTransitionSpeed="300">
    <!-- The waves, always there, under the selected system's art -->
    <image name="background" extra="static">
      <pos>0 0</pos>
      <origin>0 0</origin>
      <size>1 1</size>
      <path>${themePath}/_inc/backgrounds/waves.png</path>
      <zIndex>0</zIndex>
    </image>
    <!--
      The selected system's art: the theme's own picture (tools/render-system-backgrounds.py),
      drawn dark where the texts are and shown as it is; else Batocera's own (Carbon's photo, read
      in place), darkened by systemArtTint.
    -->
    <image name="systemArt" extra="true">
      <pos>0.5 0.5</pos>
      <origin>0.5 0.5</origin>
      <minSize>1 1</minSize>
      <path>${carbonArt}/background/${system.theme}.jpg</path>
      <color>${systemArtTint}</color>
      <zIndex>1</zIndex>
    </image>
    <image name="systemArt" extra="true" if="exists(${themePath} + '/systems/' + ${system.theme} + '/background.jpg')">
      <path>${themePath}/systems/${system.theme}/background.jpg</path>
      <color>FFFFFFFF</color>
    </image>

    <!--
      The RetroAchievements profile, like a console home's user: avatar and name, only when an
      account is set in Batocera (Main menu > Game settings > RetroAchievements)
    -->
    <webimage name="profileAvatar" extra="static" if="${global.cheevos}">
      <path>https://media.retroachievements.org/UserPic/${global.cheevos.username}.png</path>
      <pos>${profileX} ${topBarY}</pos>
      <origin>0 0</origin>
      <maxSize>${profileAvatar}</maxSize>
      <linearSmooth>true</linearSmooth>
      <zIndex>30</zIndex>
    </webimage>
    <text name="profileName" extra="static" if="${global.cheevos}">
      <text>${global.cheevos.username}</text>
      <pos>${profileNameX} ${topBarY}</pos>
      <size>0.3 0.05</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <color>${textPrimary}</color>
      <fontPath>${fontLight}</fontPath>
      <fontSize>${fontProfile}</fontSize>
      <zIndex>30</zIndex>
    </text>

    <!--
      15 tiles across a carousel wider than the screen that starts off-screen: the selection, at
      the carousel's center, stays in the second place (see homeRowX in _inc/variables.xml).
    -->
    <carousel name="systemcarousel">
      <type>horizontal</type>
      <pos>${homeRowX} ${homeRowY}</pos>
      <size>${homeRowWidth} ${homeRowHeight}</size>
      <logoSize>${homeTileSize}</logoSize>
      <logoScale>${homeScale}</logoScale>
      <scaledLogoSpacing>1</scaledLogoSpacing>
      <logoAlignment>top</logoAlignment>
      <maxLogoCount>15</maxLogoCount>
      <minLogoOpacity>1</minLogoOpacity>
      <transitionSpeed>250</transitionSpeed>
      <color>${transparent}</color>
      <zIndex>20</zIndex>
      <itemTemplate>
        <image>
          <path>${themePath}/_inc/frames/white.png</path>
          <pos>0 0</pos>
          <origin>0 0</origin>
          <size>1 1</size>
          <color>${homeTile}</color>
          <zIndex>1</zIndex>
          <!-- The selection answers at once (docs/STYLE.md): a duration takes a plain number -->
          <storyboard event="activate">
            <animation property="color" to="${homeTileSelected}" duration="0" mode="easeOut"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="color" to="${homeTile}" duration="0" mode="easeOut"/>
          </storyboard>
        </image>
        <!--
          The system's brand logo in white: Batocera's own logos (Carbon's, read where Batocera
          installs them, never copied), whitened by _inc/shaders/white.glsl. A logo drawn on a
          dark plate would be a white blob: its dark parts go too (logoCutDark, logoCutGray).
        -->
        <image>
          <path>firstfile("${carbonArt}/logos/" + {system:theme} + ".svg", "${carbonArt}/logos/" + {system:theme} + ".png")</path>
          <pos>0.5 0.5</pos>
          <origin>0.5 0.5</origin>
          <maxSize>${homeLogoSize}</maxSize>
          <opacity>contains(" ${logoAsName} ", " " + {system:theme} + " ") ? 0 : 1</opacity>
          <linearSmooth>true</linearSmooth>
          <zIndex>2</zIndex>
          <shader>
            <path>${themePath}/_inc/shaders/white.glsl</path>
            <cutDark_binding>contains(" ${logoCutGray} ", " " + {system:theme} + " ") ? 0.45 : contains(" ${logoCutDark} ", " " + {system:theme} + " ") ? 0.25 : 0</cutDark_binding>
          </shader>
        </image>
        <!-- A system without a logo, or whose logo can't be whitened: its name -->
        <text>
          <text>{system:fullName}</text>
          <visible>contains(" ${logoAsName} ", " " + {system:theme} + " ") || (!exists("${carbonArt}/logos/" + {system:theme} + ".svg") &amp;&amp; !exists("${carbonArt}/logos/" + {system:theme} + ".png"))</visible>
          <pos>0.5 0.5</pos>
          <origin>0.5 0.5</origin>
          <size>0.86 0.6</size>
          <alignment>center</alignment>
          <verticalAlignment>center</verticalAlignment>
          <forceUppercase>1</forceUppercase>
          <color>${textPrimary}</color>
          <fontPath>${fontSemiBold}</fontPath>
          <fontSize>${fontTileName}</fontSize>
          <zIndex>2</zIndex>
        </text>
        <!-- Under the selected tile: a strip with the number of games -->
        <image>
          <path>${themePath}/_inc/frames/white.png</path>
          <pos>0 1</pos>
          <origin>0 0</origin>
          <size>1 0.25</size>
          <color>${homeStrip}</color>
          <opacity>0</opacity>
          <zIndex>1</zIndex>
          <storyboard event="activate">
            <animation property="opacity" to="1" duration="0" mode="easeOut"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" to="0" duration="0" mode="easeOut"/>
          </storyboard>
        </image>
        <text>
          <text>{system:total} ${infoGames}</text>
          <pos>0.5 1.125</pos>
          <origin>0.5 0.5</origin>
          <size>0.92 0.2</size>
          <alignment>center</alignment>
          <verticalAlignment>center</verticalAlignment>
          <forceUppercase>1</forceUppercase>
          <color>${textPrimary}</color>
          <fontPath>${fontRegular}</fontPath>
          <fontSize>${fontTileGames}</fontSize>
          <opacity>0</opacity>
          <zIndex>2</zIndex>
          <storyboard event="activate">
            <animation property="opacity" to="1" duration="0" mode="easeOut"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" to="0" duration="0" mode="easeOut"/>
          </storyboard>
        </text>
        <!--
          The selection: a thin white frame just outside the tile and its strip, four bars of
          ${homeFrame} of a tile (a ninepatch blurs once the tile is scaled)
        -->
        <image>
          <path>${themePath}/_inc/frames/white.png</path>
          <pos>-${homeFrame} -${homeFrame}</pos>
          <origin>0 0</origin>
          <size>1.026 ${homeFrame}</size>
          <color>${selectionColor}</color>
          <opacity>0</opacity>
          <zIndex>3</zIndex>
          <storyboard event="activate">
            <animation property="opacity" to="1" duration="0" mode="easeOut"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" to="0" duration="0" mode="easeOut"/>
          </storyboard>
        </image>
        <image>
          <path>${themePath}/_inc/frames/white.png</path>
          <pos>-${homeFrame} 1.25</pos>
          <origin>0 0</origin>
          <size>1.026 ${homeFrame}</size>
          <color>${selectionColor}</color>
          <opacity>0</opacity>
          <zIndex>3</zIndex>
          <storyboard event="activate">
            <animation property="opacity" to="1" duration="0" mode="easeOut"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" to="0" duration="0" mode="easeOut"/>
          </storyboard>
        </image>
        <image>
          <path>${themePath}/_inc/frames/white.png</path>
          <pos>-${homeFrame} 0</pos>
          <origin>0 0</origin>
          <size>${homeFrame} 1.25</size>
          <color>${selectionColor}</color>
          <opacity>0</opacity>
          <zIndex>3</zIndex>
          <storyboard event="activate">
            <animation property="opacity" to="1" duration="0" mode="easeOut"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" to="0" duration="0" mode="easeOut"/>
          </storyboard>
        </image>
        <image>
          <path>${themePath}/_inc/frames/white.png</path>
          <pos>1 0</pos>
          <origin>0 0</origin>
          <size>${homeFrame} 1.25</size>
          <color>${selectionColor}</color>
          <opacity>0</opacity>
          <zIndex>3</zIndex>
          <storyboard event="activate">
            <animation property="opacity" to="1" duration="0" mode="easeOut"/>
          </storyboard>
          <storyboard event="deactivate">
            <animation property="opacity" to="0" duration="0" mode="easeOut"/>
          </storyboard>
        </image>
      </itemTemplate>
    </carousel>

    <!-- At the selected card's right: the system's name, maker and year -->
    <text name="systemTitle" extra="true">
      <text>${system.fullName}</text>
      <pos>${homeTitleX} ${homeTitleY}</pos>
      <size>0.62 0.08</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <color>${textPrimary}</color>
      <fontPath>${fontLight}</fontPath>
      <fontSize>${fontHomeTitle}</fontSize>
      <zIndex>30</zIndex>
    </text>
    <text name="systemMaker" extra="true">
      <text>${system.manufacturer}   ${system.releaseYearOrNull}</text>
      <pos>${homeTitleX} ${homeMakerY}</pos>
      <size>0.62 0.035</size>
      <alignment>left</alignment>
      <color>${textSecondary}</color>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${fontMeta}</fontSize>
      <zIndex>30</zIndex>
    </text>
    <!-- The engine's own line of games: the number is in the strip under the selected tile -->
    <text name="systemInfo">
      <visible>false</visible>
    </text>

    <!--
      The system's panel, under the selected card and from its left edge, like the one a console
      home opens under the selected tile: it fades in
      by itself once the selection has rested a second on a system (a theme can't react to the
      down key). Each system has its own copy of these elements and its storyboard starts over
      when the system is selected; begin and duration take plain numbers, not variables.
    -->
    <image name="infoPanel" extra="true">
      <path>${themePath}/_inc/frames/white.png</path>
      <pos>${infoX} ${infoY}</pos>
      <origin>0 0</origin>
      <size>${infoSize}</size>
      <color>${infoPanel}</color>
      <zIndex>31</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </image>
    <text name="infoFavoritesLabel" extra="true">
      <text>${infoFavorites}</text>
      <pos>${infoCol1X} ${infoLabelY}</pos>
      <size>0.108 0.04</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <forceUppercase>1</forceUppercase>
      <color>${textSecondary}</color>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${fontInfoLabel}</fontSize>
      <zIndex>32</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </text>
    <text name="infoFavorites" extra="true">
      <text>{system:favorites} &gt; 0 ? {system:favorites} : "0"</text>
      <pos>${infoCol1X} ${infoValueY}</pos>
      <size>0.108 0.04</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <color>${textPrimary}</color>
      <fontPath>${fontLight}</fontPath>
      <fontSize>${fontInfoValue}</fontSize>
      <zIndex>32</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </text>
    <text name="infoPlayedLabel" extra="true">
      <text>${infoPlayed}</text>
      <pos>${infoCol2X} ${infoLabelY}</pos>
      <size>0.108 0.04</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <forceUppercase>1</forceUppercase>
      <color>${textSecondary}</color>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${fontInfoLabel}</fontSize>
      <zIndex>32</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </text>
    <text name="infoPlayed" extra="true">
      <text>{system:gamesPlayed} &gt; 0 ? {system:gamesPlayed} : "0"</text>
      <pos>${infoCol2X} ${infoValueY}</pos>
      <size>0.108 0.04</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <color>${textPrimary}</color>
      <fontPath>${fontLight}</fontPath>
      <fontSize>${fontInfoValue}</fontSize>
      <zIndex>32</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </text>
    <text name="infoTimeLabel" extra="true">
      <text>${infoTime}</text>
      <pos>${infoCol3X} ${infoLabelY}</pos>
      <size>0.108 0.04</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <forceUppercase>1</forceUppercase>
      <color>${textSecondary}</color>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${fontInfoLabel}</fontSize>
      <zIndex>32</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </text>
    <text name="infoTime" extra="true">
      <text>{system:gameTime}</text>
      <pos>${infoCol3X} ${infoValueY}</pos>
      <size>0.108 0.04</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <color>${textPrimary}</color>
      <fontPath>${fontLight}</fontPath>
      <fontSize>${fontInfoValue}</fontSize>
      <zIndex>32</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </text>
    <!-- Second row: the last day played, the most played game and what the system supports -->
    <text name="infoLastLabel" extra="true">
      <text>${infoLast}</text>
      <pos>${infoCol1X} ${infoLabel2Y}</pos>
      <size>0.108 0.04</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <forceUppercase>1</forceUppercase>
      <color>${textSecondary}</color>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${fontInfoLabel}</fontSize>
      <zIndex>32</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </text>
    <text name="infoLast" extra="true">
      <text>empty({system:lastPlayedDate}) ? "-" : {system:lastPlayedDate}</text>
      <pos>${infoCol1X} ${infoValue2Y}</pos>
      <size>0.108 0.066</size>
      <lineSpacing>1.25</lineSpacing>
      <alignment>left</alignment>
      <verticalAlignment>top</verticalAlignment>
      <color>${textPrimary}</color>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${fontMeta}</fontSize>
      <zIndex>32</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </text>
    <text name="infoMostLabel" extra="true">
      <text>${infoMost}</text>
      <pos>${infoCol2X} ${infoLabel2Y}</pos>
      <size>0.108 0.04</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <forceUppercase>1</forceUppercase>
      <color>${textSecondary}</color>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${fontInfoLabel}</fontSize>
      <zIndex>32</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </text>
    <text name="infoMost" extra="true">
      <text>empty({system:mostPlayed}) ? "-" : {system:mostPlayed}</text>
      <pos>${infoCol2X} ${infoValue2Y}</pos>
      <size>0.108 0.066</size>
      <lineSpacing>1.25</lineSpacing>
      <alignment>left</alignment>
      <verticalAlignment>top</verticalAlignment>
      <color>${textPrimary}</color>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${fontMeta}</fontSize>
      <zIndex>32</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </text>
    <text name="infoSupportLabel" extra="true">
      <text>${infoFeatures}</text>
      <pos>${infoCol3X} ${infoLabel2Y}</pos>
      <size>0.108 0.04</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <forceUppercase>1</forceUppercase>
      <color>${textSecondary}</color>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${fontInfoLabel}</fontSize>
      <zIndex>32</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </text>
    <text name="infoSupport" extra="true">
      <text>{system:isCheevosSupported} ? {system:isNetplaySupported} ? "RetroAchievements Netplay" : "RetroAchievements" : {system:isNetplaySupported} ? "Netplay" : "-"</text>
      <pos>${infoCol3X} ${infoValue2Y}</pos>
      <size>0.108 0.066</size>
      <lineSpacing>1.25</lineSpacing>
      <alignment>left</alignment>
      <verticalAlignment>top</verticalAlignment>
      <color>${accent}</color>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${fontMeta}</fontSize>
      <zIndex>32</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="easeOut"/>
      </storyboard>
    </text>

    <!-- Bottom bar -->
    <image name="separator" extra="static">
      <path>${themePath}/_inc/frames/white.png</path>
      <pos>${homeMarginX} ${separatorY}</pos>
      <origin>0 0</origin>
      <size>0.91 0.0015</size>
      <color>${separatorColor}</color>
      <zIndex>30</zIndex>
    </image>
    <helpsystem name="help">
      <pos>${homeMarginX} ${helpY}</pos>
      <textColor>${textSecondary}</textColor>
      <iconColor>${textSecondary}</iconColor>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${fontHelp}</fontSize>
    </helpsystem>
  </view>
</theme>
