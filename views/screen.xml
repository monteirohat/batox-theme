<?xml version="1.0" encoding="UTF-8"?>
<!-- Drawn on top of every view: the clock (battery and controllers come in milestone 3). -->
<theme>
  <formatVersion>7</formatVersion>
  <view name="screen">
    <text name="clock">
      <pos>0.94 ${topBarY}</pos>
      <origin>1 0</origin>
      <size>0.12 0.05</size>
      <alignment>right</alignment>
      <color>${textSecondary}</color>
      <fontSize>${fontClock}</fontSize>
    </text>
  </view>
</theme>
