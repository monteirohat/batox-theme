<?xml version="1.0" encoding="UTF-8"?>
<!-- Detailed: a list of games on the left, the details on the right; for small screens. -->
<theme>
  <formatVersion>7</formatVersion>
  <view name="detailed">
    <textlist name="gamelist">
      <pos>${marginX} 0.12</pos>
      <size>0.40 0.78</size>
      <alignment>left</alignment>
      <horizontalMargin>0.01</horizontalMargin>
      <primaryColor>${textSecondary}</primaryColor>
      <secondaryColor>${textMuted}</secondaryColor>
      <selectedColor>${textPrimary}</selectedColor>
      <selectorColor>${accentGlow}</selectorColor>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>${fontBody}</fontSize>
      <zIndex>20</zIndex>
    </textlist>
    <text name="md_name">
      <pos>0.52 0.12</pos>
      <size>0.42 0.10</size>
    </text>
    <text name="md_developer">
      <pos>0.52 0.23</pos>
      <size>0.42 0.04</size>
    </text>
    <datetime name="md_releasedate">
      <pos>0.52 0.27</pos>
      <size>0.13 0.04</size>
      <format>%Y</format>
    </datetime>
    <text name="md_genre">
      <pos>0.66 0.27</pos>
      <size>0.28 0.04</size>
    </text>
    <text name="md_players">
      <pos>0.52 0.31</pos>
      <size>0.13 0.04</size>
    </text>
    <rating name="md_rating">
      <pos>0.66 0.315</pos>
      <size>0.10 0.03</size>
    </rating>
    <text name="md_description">
      <pos>0.52 0.37</pos>
      <size>0.42 0.52</size>
    </text>
  </view>
</theme>
